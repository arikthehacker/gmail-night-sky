{
  "manifest_version": 3,
  "name": "Gmail Night Sky",
  "version": "1.0.0",
  "description": "A soft, sparkly nighttime sky behind Gmail.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["stars.css", "theme.css"]
    }
  ]
}
